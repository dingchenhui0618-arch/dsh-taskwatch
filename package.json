{
  "name": "dsh-taskwatch",
  "version": "1.0.2",
  "description": "Read-only task monitor for DeepSeek Harness: sessions, background jobs, subagents, goals, workflows and pending approvals, as a phone-friendly page and a GUI sidebar panel. · DSH 只读任务监控：会话、后台任务、子代理、目标轮次、工作流与待审批，附手机页面与 GUI 侧边栏面板。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "monitor",
    "observability",
    "mobile",
    "pwa",
    "remote"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/check-bundle.mjs",
    "demo": "node scripts/make-demo.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingchenhui0618-arch/dsh-taskwatch.git"
  },
  "homepage": "https://github.com/dingchenhui0618-arch/dsh-taskwatch#readme",
  "bugs": {
    "url": "https://github.com/dingchenhui0618-arch/dsh-taskwatch/issues"
  },
  "author": "dingchenhui0618-arch",
  "license": "Apache-2.0"
}
