{
  "name": "dsh-taskwatch",
  "version": "1.4.0",
  "description": "手机端的 DeepSeek Harness，不用装 App：一份只读任务监控页长成的手机浏览器客户端（会话 / 实时对话 / 交付文件 / 任务监控）。Phone client for DeepSeek Harness with no app to install.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "monitor",
    "observability",
    "mobile",
    "pwa",
    "remote"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/check-bundle.mjs && node scripts/check-files.mjs",
    "demo": "node scripts/make-demo.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingchenhui0618-arch/dsh-taskwatch.git"
  },
  "homepage": "https://github.com/dingchenhui0618-arch/dsh-taskwatch#readme",
  "bugs": {
    "url": "https://github.com/dingchenhui0618-arch/dsh-taskwatch/issues"
  },
  "author": "dingchenhui0618-arch",
  "license": "Apache-2.0"
}
